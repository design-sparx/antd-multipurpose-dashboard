# Normalize line endings to LF (cross-platform consistency; matches Prettier 3 default).
*           text=auto eol=lf

# Treat lockfiles and generated files as text (still LF).
package-lock.json   text eol=lf
yarn.lock           text eol=lf
pnpm-lock.yaml      text eol=lf

# Mark truly binary files.
*.png              binary
*.jpg              binary
*.jpeg             binary
*.gif              binary
*.ico              binary
*.webp             binary
*.woff             binary
*.woff2            binary
*.ttf              binary
*.eot              binary
*.pdf              binary
*.zip              binary
*.mp4              binary
*.webm             binary
